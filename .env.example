# Son of Anton Agent Environment Configuration
# Copy this file to ~/.son-of-anton/.env and fill in your secrets.
# Non-secret settings live in ~/.son-of-anton/config.yaml.

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# The fork ships two API-key providers plus custom endpoints:
#   - OpenAI API   (model.provider: openai-api)
#   - DeepSeek     (model.provider: deepseek)
#   - Custom       (model.provider: custom + custom_providers in config.yaml)
# Local endpoints (llama-swap, ollama, vllm, ...) are configured as custom
# providers in config.yaml:
#
#   custom_providers:
#     custom:
#       base_url: http://127.0.0.1:8080/v1

# OpenAI API key — https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional OpenAI base URL override (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=

# DeepSeek API key — https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=

# Optional DeepSeek base URL override (default: https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=

# =============================================================================
# WEB SEARCH & EXTRACT TOOLS
# =============================================================================
# Any one of these providers enables the web_search/web_extract tools.

# Exa API Key — https://exa.ai
# EXA_API_KEY=

# Parallel API Key — https://parallel.ai
# PARALLEL_API_KEY=

# Firecrawl API Key — https://firecrawl.dev/
# FIRECRAWL_API_KEY=

# Firecrawl self-hosted instance (Docker)
# FIRECRAWL_API_URL=http://localhost:3002

# Tavily API Key — https://tavily.com
# TAVILY_API_KEY=

# SearXNG instance URL
# SEARXNG_URL=http://localhost:8080

# Brave Search API Key — https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# =============================================================================
# MEMORY PROVIDERS (one active provider, set memory.provider in config.yaml)
# =============================================================================

# Honcho — https://app.honcho.dev
# HONCHO_API_KEY=
# HONCHO_BASE_URL=

# Mem0 — https://mem0.ai
# MEM0_API_KEY=

# Supermemory — https://supermemory.ai
# SUPERMEMORY_API_KEY=

# OpenViking — https://openviking.io
# OPENVIKING_API_KEY=
# OPENVIKING_ENDPOINT=

# RetainDB
# RETAINDB_API_KEY=
# RETAINDB_BASE_URL=

# Hindsight
# HINDSIGHT_API_KEY=
# HINDSIGHT_API_URL=

# =============================================================================
# TERMINAL TOOL
# =============================================================================
# Backend (local|ssh) and working directory are configured in config.yaml
# under terminal:. Only secrets belong here.

# Sudo password for `sudo -S` (plaintext — trusted machines only)
# SUDO_PASSWORD=your_password_here

# SSH remote execution (for terminal.backend: ssh) — key paths are not
# secrets, but the backend expects them under terminal: in config.yaml:
#
#   terminal:
#     backend: ssh
#     ssh_host: 192.168.1.100
#     ssh_user: agent
#     ssh_port: 22
#     ssh_key: ~/.ssh/id_rsa

# =============================================================================
# MESSAGING GATEWAY (Discord, Slack, Signal)
# =============================================================================

# Discord
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USERS=              # Comma-separated user IDs

# Slack
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=                # Comma-separated Slack user IDs

# Signal (signald/signal-cli HTTP bridge)
# SIGNAL_HTTP_URL=http://127.0.0.1:8080

# Gateway-wide: allow ALL users without an allowlist (default: false = deny)
# GATEWAY_ALLOW_ALL_USERS=false

# =============================================================================
# SKILLS HUB (GitHub integration)
# =============================================================================

# GitHub Personal Access Token — higher API rate limits for skill search/install
# https://github.com/settings/tokens (fine-grained recommended)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub App credentials (optional — bot identity on PRs)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_INSTALLATION_ID=

# =============================================================================
# OBSERVABILITY (Langfuse plugin)
# =============================================================================

# SON_OF_ANTON_LANGFUSE_PUBLIC_KEY=pk-lf-...
# SON_OF_ANTON_LANGFUSE_SECRET_KEY=sk-lf-...
# SON_OF_ANTON_LANGFUSE_BASE_URL=https://cloud.langfuse.com

# =============================================================================
# DEBUG OPTIONS
# =============================================================================
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
