# Son of Anton Agent CLI Configuration
# Copy settings from this example into ~/.son-of-anton/config.toml, or use
# `son-of-anton config set <section.key> <value>` to update the active profile.
# Only documented secret environment variables in .env take precedence over
# their corresponding settings.

# =============================================================================
# Model Configuration
# =============================================================================
model:
  # Default model (overridable per request by the router, /model, or --model).
  default: "deepseek-v4"
  # Inference provider:
  #   "auto"       - auto-detect from credentials
  #   "deepseek"   - DeepSeek API (DEEPSEEK_API_KEY)
  #   "openai-api" - OpenAI API (OPENAI_API_KEY)
  #   "custom"     - endpoint declared under custom_providers below
  provider: "custom"

# Local / self-hosted OpenAI-compatible endpoints (llama-swap, ollama, vllm).
custom_providers:
  custom:
    base_url: "http://127.0.0.1:8080/v1"

# =============================================================================
# Request Router (agent mode selection per session)
# =============================================================================
router:
  enabled: true
  # Selectable agent modes. Keyword classification runs on the FIRST message of
  # a session only; /mode pins it explicitly on any turn. "standard" is always
  # available - drop the others on a deployment with no use for them and their
  # keywords stop routing.
  modes: ["standard", "physics", "research"]

# =============================================================================
# Physics Mode
# =============================================================================
physics:
  model: "deepseek-v4"
  # Resolution order: physics.base_url -> provider defaults (deepseek/openai)
  # -> custom_providers.<provider>.base_url -> http://127.0.0.1:8080/v1
  base_url: "http://127.0.0.1:8080/v1"

# =============================================================================
# Terminal Tool
# =============================================================================
terminal:
  backend: "local"           # local | ssh
  cwd: "."                   # working directory for terminal commands
  timeout: 180
  # ssh_host: 192.168.1.100  # for backend: ssh
  # ssh_user: agent
  # ssh_port: 22
  # ssh_key: ~/.ssh/id_rsa

# =============================================================================
# Agent Loop
# =============================================================================
agent:
  max_turns: 90              # tool-calling iterations per conversation

# =============================================================================
# Context Compaction
# =============================================================================
compaction:
  enabled: true
  threshold: 0.85            # compact at 85% of context limit

# =============================================================================
# Memory (cross-session learning; provider optional)
# =============================================================================
memory:
  memory_enabled: true
  provider: ""               # honcho | mem0 | supermemory | ... (empty = off)
  # Built-in memory scope: "" = auto by surface (cli -> cli, signal/discord/
  # slack -> gateway, anything else -> shared). Pin it for non-standard
  # front-ends. "shared" is always visible; "cli"/"gateway" are per-surface.
  scope: ""
  # Retrieval-augmented recall (optional): embed session journals + note
  # files through an OpenAI-compatible /v1/embeddings endpoint and inject the
  # closest chunks into each turn's API copy. Build with `son-of-anton rag index`.
  rag:
    enabled: false
    base_url: ""             # e.g. http://10.0.0.6:4002/v1 (Bifrost)
    model: "bge-m3"
    api_key_env: "BIFROST_SOA_VK"
    top_k: 5
    min_score: 0.0
    # Notes tree: notes/<scope>/**/*.md is discovered automatically.
    notes_dir: ""            # default: $SON_OF_ANTON_HOME/notes
    sources: []              # extra files outside the tree: [{path: ..., scope: ...}]

# =============================================================================
# Cron (scheduled jobs)
# =============================================================================
cron:
  allow_agent_scheduling: false   # true lets the agent schedule its own jobs

# =============================================================================
# Skills (bundled skills load by default; install more with
# `son-of-anton skills install <name>`)
# =============================================================================
skills:
  project_discovery: true

# =============================================================================
# Security / Permissions
# =============================================================================
security:
  # /perm default|ask|lockdown|yolo maps onto the approval core.
  # lockdown forces every command through human approval.
  lockdown: false

# =============================================================================
# Display
# =============================================================================
display:
  skin: "default"            # default | ares | mono | slate (or ~/.son-of-anton/skins/*.yaml)
